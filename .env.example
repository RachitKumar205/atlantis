# atlantis — environment template
# Copy to .env and edit for local development.

# gRPC server bind
GRPC_LISTEN=:9090

# Postgres
#
# atlantis-pg.test, not localhost. `make dev` runs Postgres and memcached as
# containers under Apple's `container`, which reaches them by DNS name rather
# than through a published port — `container run -p` accepts a connection and
# then does not relay it. A name also survives a restart, where the container's
# IP does not.
#
# The name only resolves once BOTH halves of container DNS are set up; `make
# dev-infra-dns` checks them and prints what is missing.
#
# Running Postgres some other way (Homebrew, Docker, a remote host)? Put the
# host back to localhost here — nothing else depends on the name.
PG_URL=postgres://atlantis:atlantis@atlantis-pg.test:5432/atlantis?sslmode=disable
PG_MAX_CONNS=50
PG_MIN_CONNS=10
PG_MAX_CONN_IDLE=5m
PG_MAX_CONN_LIFETIME=1h
PG_HEALTHCHECK_PERIOD=30s
PG_QUERY_TIMEOUT_DEFAULT=2s

# Memcached addresses (comma-separated for sharding)
MEMCACHED_ADDR=atlantis-memcached.test:11211

# Cache tier-0 LRU
CACHE_LRU_SIZE=1024

# Observability
#
# OTEL_EXPORTER_OTLP_ENDPOINT was listed here and read by nothing: there is no
# OTLP exporter in the build and no tracing code behind it, so setting it did
# exactly nothing and said so nowhere. Removed rather than left as a promise —
# a sample that names a setting no process reads is worse than one that omits
# it, because the reader believes they have configured something.
#
# atlantis exposes Prometheus metrics (internal/obs/metrics.go) and structured
# logs. Tracing is not wired.
LOG_LEVEL=info

# mTLS material. REQUIRED — the server refuses to start without all three, and
# accepts no plaintext connection. Caller identity comes from the client
# certificate's CN, and the allowlist, the cert binding and the capability
# grants all key off it, so a server without these has no authorization either.
#
# Locally: `make dev-certs` writes these into ./certs.
TLS_CERT_FILE=./certs/server.crt
TLS_KEY_FILE=./certs/server.key
TLS_CA_FILE=./certs/ca.crt

# Outbox worker
OUTBOX_BATCH_SIZE=100
OUTBOX_DRAIN_INTERVAL=250ms
OUTBOX_ALERT_LAG=5m

# Per-caller rate limits. RATE_LIMIT_PER_CALLER format: "caller=qps,caller=qps".
RATE_LIMIT_DEFAULT_QPS=1000
RATE_LIMIT_BURST=200
RATE_LIMIT_PER_CALLER=
RATE_LIMIT_SATURATION_CUTOFF=0.80

# Apply infra + tidectl migrations on server boot. Default off so a local-dev
# iteration does not auto-migrate a shared database, and because two replicas
# racing the same boot-time migration is a real outage — a deployment runs
# `tidectl migrate-up` from its pipeline instead.
AUTO_MIGRATE=false
MIGRATIONS_DIR=migrations

# ── Atlantis Cloud ─────────────────────────────────────────────────────────
#
# Cloud is the control plane: it holds accounts, organisations, membership and
# second factors, and it signs the assertions every console verifies. Its own
# database, separate from the console's — locally the same PostgreSQL instance,
# schema `cloud`.
#
# Its own ROLE too, and this one is not optional. cloud.totp_secrets and
# cloud.backup_codes are protected by row-level security, and a superuser reads
# straight through a policy even with FORCE set — so Cloud refuses to start on
# one. The role must also OWN the tables, because FORCE binds a table's owner:
# grants alone leave the policies attached and inert.
#
# Locally: `make dev-cloud-role` creates it and transfers ownership of anything
# an earlier superuser-run Cloud left behind.
CLOUD_PG_URL=postgres://atlantis_cloud:cloud@atlantis-pg.test:5432/atlantis?sslmode=disable
CLOUD_LISTEN=:9500
CLOUD_ISSUER=http://localhost:9500
CLOUD_SIGNING_KEY=./certs/cloud-signing-key.pem

# The base every emailed link is built from. Required, no default.
#
# A wrong value here does not fail — it sends every user a working verification
# or password-reset link pointing at the wrong host, which is a broken flow if
# that host is ours and a credible phishing primitive if it is not. It is not
# derived from the Host header, because the Host header is attacker-controlled.
CLOUD_PUBLIC_URL=http://localhost:9500

# Extra origins accepted on state-changing /api/* routes. Development only.
#
# Those routes require an Origin header and compare it to CLOUD_PUBLIC_URL,
# because Cloud's session cookie is SameSite=Lax rather than the console's
# Strict and cannot lean on the cookie alone. The check is deliberately NOT
# applied to POST /reset or POST /authorize/reauth: those arrive as form
# navigations from a mail client, and Referrer-Policy: no-referrer makes such a
# request send `Origin: null`.
#
# Set this only when running the frontend with `npm run dev --workspace
# web/cloud`, which serves the page from :5173 and proxies /api to Cloud with
# changeOrigin — so neither the public URL nor the Host matches what the browser
# sends. Leave it empty otherwise.
# CLOUD_EXTRA_ORIGINS=http://localhost:5173

# Mail. With no CLOUD_SMTP_ADDR, Cloud writes verification and reset links to
# its log instead of sending them, warns at startup, and warns again on every
# message. That is the intended development flow; the warnings are what stop it
# becoming the accidental production one, where accounts are created, the
# response says a message is on its way, and the link is in a log nobody reads.
CLOUD_SMTP_ADDR=
CLOUD_SMTP_FROM=
CLOUD_SMTP_USER=
CLOUD_SMTP_PASSWORD=

# Refuse passwords that appear in a known breach, via Have I Been Pwned's
# k-anonymity range API — the password never leaves this process, only the first
# five characters of its SHA-1. Set to false to skip it entirely. When it is on
# and the service cannot be reached, the password is accepted and a warning is
# logged: sign-up must not stop working because a third party is down.
CLOUD_HIBP_CHECK=true

# Read X-Forwarded-For when rate limiting. Leave off unless something you
# control terminates in front — the header is trivially spoofable, and a limiter
# keyed on a spoofable value is one an attacker resets on every request.
CLOUD_TRUST_PROXY=false

# The keyset Cloud seals each account's TOTP secret with. Required.
#
# A second factor has to be recomputed to be checked, so unlike the argon2id
# password hash beside it, it cannot be hashed — only encrypted. Without this,
# Cloud can neither enrol a factor nor verify one, and refuses to start.
#
# Losing it is not recoverable: every enrolled secret stays intact and
# permanently unopenable, which presents as every account being unable to finish
# signing in. `cloud data-key` prints one; `make dev-cloud-data-key` writes one
# to ./certs for local use.
CLOUD_DATA_KEY=

# Secure flag on Cloud's session cookie. Leave false for http://localhost; set
# true once a TLS terminator sits in front.
CLOUD_COOKIE_SECURE=false

# Signing in with GitHub and Google. Both optional, and off by default.
#
# A provider with neither value set is not registered at all, and its URLs
# answer 404 — an unconfigured sign-in method should not exist rather than exist
# and fail at the redirect. Setting one of a pair without the other is refused
# at startup, because the missing half would otherwise be discovered by somebody
# who had already granted access at the provider.
#
# Register the callback URL at each provider as CLOUD_PUBLIC_URL plus
# /auth/github/callback (and /auth/google/callback). Cloud builds that from
# CLOUD_PUBLIC_URL and never from the request, so a mismatch here is a sign-in
# the provider refuses rather than one that goes somewhere unexpected.
#
# Signing in with a provider is still ONE factor. It produces the same
# half-finished login a password does, and the second factor is still required.
CLOUD_GITHUB_CLIENT_ID=
CLOUD_GITHUB_CLIENT_SECRET=
CLOUD_GOOGLE_CLIENT_ID=
CLOUD_GOOGLE_CLIENT_SECRET=

# CLOUD_SIGNIN_APP_URL was here, naming where a finished OAuth callback sent the
# browser. It is gone: Cloud serves the sign-in application itself, so the only
# correct value was CLOUD_PUBLIC_URL, and two settings that must agree are a
# setting that will eventually disagree. The callback redirects to a relative
# path, which resolves against this origin by construction.

# ── The management console ──────────────────────────────────────────────────
#
# The console is the browser surface: schema, history, approvals, callers,
# audit. It holds no accounts of its own — every sign-in is a signed assertion
# from Cloud, verified against the JWKS below — and it serves one organisation
# per process.
#
# It refuses to start without CONSOLE_PG_URL, CONSOLE_SESSION_SECRET,
# CONSOLE_DATA_KEY, CLOUD_AUDIENCE and CLOUD_JWKS_URL. That is deliberate for
# the last two: the verifier compares issuer and audience for exact equality,
# and an empty expected value does not weaken the check, it removes it — so a
# console missing either would start and accept assertions from any issuer, for
# any console, with nothing downstream able to notice.
CONSOLE_PG_URL=postgres://atlantis_console:console@atlantis-pg.test:5432/atlantis?sslmode=disable
CONSOLE_LISTEN=:3000

# At least 32 characters. Signs the session cookie.
CONSOLE_SESSION_SECRET=

# Base64 Tink keyset. Seals each organisation's atlantis client key in
# console.orgs, with the organisation name as associated data.
#
# NOT recoverable. Lose it and every organisation's credentials are permanently
# unreadable, which presents as every organisation being unreachable with
# nothing in the schema looking wrong. `make dev-data-key` writes one locally.
CONSOLE_DATA_KEY=

# This console's own name, and it must equal the -console-url the organisation
# was registered with: Cloud mints assertions with that value as the audience
# and redirects to it, so the two are one string in two places.
#
# It is also what the provisioner writes into cloud.orgs.console_url — the URL
# behind "Open organisation". Pointing it at localhost is right only when the
# console runs on the machine holding the browser; against the local cluster the
# console runs in it, and `make dev-k8s-load` sets this to
# http://atl-dev.test:30300 to match. A stale localhost here is not a
# misconfiguration that fails: it is a button that works for one person and
# gives everybody else ERR_CONNECTION_REFUSED.
CLOUD_AUDIENCE=http://localhost:3000
CLOUD_JWKS_URL=http://localhost:9500/.well-known/jwks.json

# Secure cookies. Leave false for plain-HTTP local development; true anywhere
# the console is reached over TLS.
CONSOLE_COOKIE_SECURE=false

# Trust X-Forwarded-For when rate-limiting by client address. Only where a proxy
# you control sets it — otherwise the header is attacker-supplied and every
# limiter becomes per-attacker-chosen-address.
CONSOLE_TRUST_PROXY=false

CONSOLE_AUDIT_RETENTION_DAYS=365
SANDBOX_PER_USER_LIMIT=100
SANDBOX_TTL=30m

# ── Certificate enrolment ───────────────────────────────────────────────────
#
# How a machine gets a client certificate for a caller. The machine generates
# its own key and sends only a certificate signing request; no private key
# crosses the wire in either direction.
#
# ALL OF IT OR NONE OF IT. The console refuses to start half-configured, because
# every partial state fails late and quietly: a signer address with no client
# certificate is a handshake failure that reads as "signer unreachable", and a
# listener with no key does not listen while the console serves its normal port
# perfectly. Leave every line empty to run without enrolment, and the route that
# mints a token says so rather than answering 404.
#
# The predecessor of this feature was one optional setting read at request time.
# No deployment ever set it, so the console shipped an issuance button that
# answered 503 for its entire life and nothing at startup said so.
ATL_SIGNER_ADDR=
ATL_SIGNER_CERT=./certs/signer-client.crt
ATL_SIGNER_KEY=./certs/signer-client.key
ATL_SIGNER_CA=./certs/signer-ca.crt

# The enrolment listener. Separate from CONSOLE_LISTEN, which serves browsers
# behind a TLS terminator the console does not control and so cannot inspect a
# client certificate. This one terminates its own TLS, and carries exactly two
# routes — never the console API or the SPA, which every machine that enrols
# would otherwise be able to reach.
CONSOLE_ENROLL_LISTEN=
CONSOLE_ENROLL_TLS_CERT=./certs/enroll-server.crt
CONSOLE_ENROLL_TLS_KEY=./certs/enroll-server.key

# CONSOLE_ENROLL_CLIENT_CA is RETIRED. The console refuses to start if it is
# still set, rather than reading it and applying nothing.
#
# It named one authority for the listener to verify every renewing machine
# against. That works while every caller in a deployment chains to one root, and
# cannot work once each organisation has its own — so renewal now verifies the
# presented certificate against that organisation's CA, taken from console.orgs
# after the certificate's fingerprint says whose it is.
#
# Nothing replaces it. Unset it.

# Where a machine reaches the listener above, which is not the bind address: a
# `:3443` or a loopback says nothing about how anything outside gets here.
#
# The console cannot derive this and must not read it from the Host header —
# that header is attacker-controlled and the page using this value prints a live
# enrolment token, so a wrong host is a token handed to whoever owns it. The
# same reasoning as CLOUD_PUBLIC_URL.
CONSOLE_ENROLL_PUBLIC_URL=https://localhost:3443

# ── The certificate signer ──────────────────────────────────────────────────
#
# Holds the certificate authority's private key and signs caller leaves. Run it
# with `make dev-signer`, which points these at ./certs.
#
# ── Two authorities, and they must not be one ───────────────────────────────
#
# CA_DIR is what the signer ISSUES from. SIGNER_CLIENT_CA is what it ACCEPTS
# callers by. Every leaf it issues is marked for client authentication, so a
# signer trusting its own issuing authority would accept every certificate it
# had ever produced as a credential to itself — caller `backend` could dial in
# with its own legitimate certificate, ask for `payments`, and get it.
# SIGNER_ALLOWED_CLIENT_CNS is the second, independent answer to the same
# question. The signer refuses to start without either.
CA_DIR=./certs/ca-private
SIGNER_LISTEN=127.0.0.1:7070
SIGNER_TLS_CERT=./certs/ca-private/signer-server.crt
SIGNER_TLS_KEY=./certs/ca-private/signer-server.key
SIGNER_CLIENT_CA=./certs/signer-ca.crt
SIGNER_ALLOWED_CLIENT_CNS=atlantis-console

# Health answers here, in plaintext, because the container health check holds no
# client certificate and cannot complete a handshake with the port above.
SIGNER_HEALTH_LISTEN=127.0.0.1:7071

# The signer also needs PG_URL, set at the top of this file: it reads
# atlantis.caller_identities so issuance is gated on a registered caller.
# Required rather than optional — an unset setting must not be a way to turn a
# check off, and it used to be exactly that.

# ── The provisioner ─────────────────────────────────────────────────────────
#
# Turns queued organisations into running ones: claims from
# cloud.org_provisioning, builds the organisation in Kubernetes, registers it
# with the console, and points Cloud at that console. Run it with
# `make dev-provisioner`, which fills these in for the local cluster.
#
# It is a separate process from `cloud serve` because it holds Kubernetes
# credentials, and cloud serve holds every password, every TOTP secret and the
# assertion signing key. Keeping them apart means script on Cloud's origin
# cannot schedule pods.
#
# It also needs CLOUD_PG_URL, CONSOLE_PG_URL, CONSOLE_DATA_KEY and
# CLOUD_AUDIENCE, all set above. CLOUD_AUDIENCE does double duty: it is the
# audience Cloud mints assertions for AND the value written to
# cloud.orgs.console_url, and those must be byte-identical. One setting rather
# than two that have to agree.
#
# Kubernetes credentials come from the ambient KUBECONFIG, or from the pod's
# service account when it runs in-cluster. There is no setting for it.

# ── The five with no default, and why guessing is worse than refusing ───────
#
# A guessed host produces certificates whose SAN matches nothing, and the
# failure reads as a handshake error naming a host nobody configured. A guessed
# image is a pod that cannot start, on nodes with no route to a registry. And
# MEMCACHED_ADDR defaults to localhost:11211 in the server, which inside a pod
# is the one value guaranteed to be wrong — atlantis's readiness probe performs
# a real cache operation, so wrong here means never Ready rather than slow.
PROVISIONER_EXTERNAL_HOST=atl-dev.test
PROVISIONER_SERVER_IMAGE=atlantis-server:local
PROVISIONER_SIGNER_IMAGE=atlantis-signer:local
PROVISIONER_POSTGRES_IMAGE=atlantis-pg:17.11
PROVISIONER_MEMCACHED_ADDR=memcached.atlantis-system.svc.cluster.local:11211

# Health and readiness. Plaintext, and it has to accept connections from
# wherever the orchestrator probes from — in Kubernetes that is the node, so
# this binds every interface there.
PROVISIONER_HEALTH_LISTEN=127.0.0.1:8082

# Prometheus metrics, on a listener of their own.
#
# Separate from the health address because the two are read by different people.
# The probes must be open; the metrics need not be, and when they shared a port
# the per-organisation counts were readable by any pod in the cluster — tenant
# namespaces restrict ingress, not egress.
#
# Loopback by default, so nothing outside the process can read them. Point this
# at an interface a scraper can reach when you have one, and give it a
# credential at the same time.
PROVISIONER_METRICS_LISTEN=127.0.0.1:9102

# ── The lease, and the one relationship between these that matters ──────────
#
# PROVISIONER_LEASE must outlive PROVISIONER_READY_TIMEOUT, and the provisioner
# refuses to start otherwise. A readiness wait can burn the whole timeout; a
# lease that expires during it lets a second provisioner claim an organisation
# this one is still building, and the first then stamps its result over the
# row. The default lease is three times the timeout, computed rather than
# constant, so raising one raises the other.
#
# Unset, these default to: 5m readiness, 15m lease, 30s heartbeat, 10s poll.
# PROVISIONER_READY_TIMEOUT=5m
# PROVISIONER_LEASE=15m
# PROVISIONER_LEASE_HEARTBEAT=30s
# PROVISIONER_POLL_INTERVAL=10s

# How often ready organisations are checked against the cluster, and requeued
# if the cluster no longer has them. Nothing else looks at a ready row, so
# without this an organisation whose namespace is deleted stays ready for ever
# while serving nothing. Much slower than the poll: it asks the API server about
# every ready organisation, so it is the one loop whose cost grows with the
# number of customers.
# PROVISIONER_RECONCILE_INTERVAL=5m

# How much life the console's certificate for an organisation must have left
# before a reconcile pass replaces it.
#
# The number is sized against the outage it prevents rather than against the
# certificate: it is how long the provisioner can be wedged, or simply not
# running, before an organisation loses console access entirely. Ten days leaves
# more than a week of margin; a value tight to the renewal cadence would make
# the provisioner a component whose weekend outage is a fleet-wide one.
#
# Console certificates last thirty days, so this replaces them with a third of
# their life left. The two numbers move together: a window wider than the
# lifetime rotates on every pass, and a much narrower one spends the margin.
#
# Alert on atlantis_provisioning_console_cert_seconds_left, which counts down to
# the soonest expiry in the fleet. It should saw-tooth as credentials renew;
# falling steadily means rotation has stopped, and every way it can stop looks
# the same from outside — a wedged provisioner, expired Kubernetes credentials,
# an unreachable console database. None of them raise an error anybody sees.
# Set the threshold well above this window: reaching the window already means a
# pass was missed. The metric reads NaN until the first reconcile pass measures
# something, so a freshly started provisioner does not trip the rule — a gauge
# defaulting to zero would read as "expiring now" and page on every deploy.
# PROVISIONER_CONSOLE_CERT_RENEW_WITHIN=240h

# Backoff after a failed attempt: escalating, capped. Without escalation a
# permanent fault becomes a loop that provisions nothing and fills the log;
# without a cap a transient one takes hours to recover from unattended.
# PROVISIONER_RETRY_BASE=30s
# PROVISIONER_RETRY_MAX=30m

# Names this process in the queue. Defaults to the hostname, which is the pod
# name in Kubernetes — what somebody reading a stuck row wants to see.
# PROVISIONER_NAME=

# ── Left unset on purpose ───────────────────────────────────────────────────
#
# These have defaults inside the provisioning package, and setting them here
# would create a second source of truth that silently wins. Uncomment only to
# override deliberately.
#
# PROVISIONER_NAMESPACE_PREFIX=org-
# PROVISIONER_STORAGE_CLASS=          (empty = the cluster's default)
# PROVISIONER_PULL_POLICY=IfNotPresent
# PROVISIONER_POD_CIDR=10.244.0.0/16
# PROVISIONER_OPERATOR_NAMESPACE=cnpg-system
# PROVISIONER_POSTGRES_INSTANCES=1
# PROVISIONER_POSTGRES_STORAGE=1Gi
