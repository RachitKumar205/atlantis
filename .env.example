# atlantis — environment template
# Copy to .env and edit for local development.

# gRPC server bind
GRPC_LISTEN=:9090

# Postgres
PG_URL=postgres://atlantis:atlantis@localhost:5432/atlantis?sslmode=disable
PG_MAX_CONNS=50
PG_MIN_CONNS=10
PG_MAX_CONN_IDLE=5m
PG_MAX_CONN_LIFETIME=1h
PG_HEALTHCHECK_PERIOD=30s
PG_QUERY_TIMEOUT_DEFAULT=2s

# Memcached addresses (comma-separated for sharding)
MEMCACHED_ADDR=localhost:11211

# Cache tier-0 LRU
CACHE_LRU_SIZE=1024

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# mTLS material. REQUIRED — the server refuses to start without all three, and
# accepts no plaintext connection. Caller identity comes from the client
# certificate's CN, and the allowlist, the cert binding and the capability
# grants all key off it, so a server without these has no authorization either.
#
# Locally: `make dev-certs` writes these into ./certs.
TLS_CERT_FILE=./certs/server.crt
TLS_KEY_FILE=./certs/server.key
TLS_CA_FILE=./certs/ca.crt

# Outbox worker
OUTBOX_BATCH_SIZE=100
OUTBOX_DRAIN_INTERVAL=250ms
OUTBOX_ALERT_LAG=5m

# Per-caller rate limits. RATE_LIMIT_PER_CALLER format: "caller=qps,caller=qps".
RATE_LIMIT_DEFAULT_QPS=1000
RATE_LIMIT_BURST=200
RATE_LIMIT_PER_CALLER=
RATE_LIMIT_SATURATION_CUTOFF=0.80

# Apply infra + tidectl migrations on server boot. Default off so a local-dev
# iteration does not auto-migrate a shared database, and because two replicas
# racing the same boot-time migration is a real outage — a deployment runs
# `tidectl migrate-up` from its pipeline instead.
AUTO_MIGRATE=false
MIGRATIONS_DIR=migrations
