# atlantis — environment template
# Copy to .env and edit for local development.

# gRPC server bind
GRPC_LISTEN=:9090

# Postgres
PG_URL=postgres://atlantis:atlantis@localhost:5432/atlantis?sslmode=disable
PG_MAX_CONNS=50
PG_MIN_CONNS=10
PG_MAX_CONN_IDLE=5m
PG_MAX_CONN_LIFETIME=1h
PG_HEALTHCHECK_PERIOD=30s
PG_QUERY_TIMEOUT_DEFAULT=2s

# Memcached addresses (comma-separated for sharding)
MEMCACHED_ADDR=localhost:11211

# Cache tier-0 LRU
CACHE_LRU_SIZE=1024

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# mTLS material. REQUIRED — the server refuses to start without all three, and
# accepts no plaintext connection. Caller identity comes from the client
# certificate's CN, and the allowlist, the cert binding and the capability
# grants all key off it, so a server without these has no authorization either.
#
# Locally: `make dev-certs` writes these into ./certs.
TLS_CERT_FILE=./certs/server.crt
TLS_KEY_FILE=./certs/server.key
TLS_CA_FILE=./certs/ca.crt

# Outbox worker
OUTBOX_BATCH_SIZE=100
OUTBOX_DRAIN_INTERVAL=250ms
OUTBOX_ALERT_LAG=5m

# Per-caller rate limits. RATE_LIMIT_PER_CALLER format: "caller=qps,caller=qps".
RATE_LIMIT_DEFAULT_QPS=1000
RATE_LIMIT_BURST=200
RATE_LIMIT_PER_CALLER=
RATE_LIMIT_SATURATION_CUTOFF=0.80

# Apply infra + tidectl migrations on server boot. Default off so a local-dev
# iteration does not auto-migrate a shared database, and because two replicas
# racing the same boot-time migration is a real outage — a deployment runs
# `tidectl migrate-up` from its pipeline instead.
AUTO_MIGRATE=false
MIGRATIONS_DIR=migrations

# ── Atlantis Cloud ─────────────────────────────────────────────────────────
#
# Cloud is the control plane: it holds accounts, organisations and membership,
# and it signs the assertions every console verifies. Its own database, separate
# from the console's — locally the same PostgreSQL instance, schema `cloud`.
CLOUD_PG_URL=postgres://atlantis:atlantis@localhost:5432/atlantis?sslmode=disable
CLOUD_LISTEN=:9500
CLOUD_ISSUER=http://localhost:9500
CLOUD_SIGNING_KEY=./certs/cloud-signing-key.pem

# The base every emailed link is built from. Required, no default.
#
# A wrong value here does not fail — it sends every user a working verification
# or password-reset link pointing at the wrong host, which is a broken flow if
# that host is ours and a credible phishing primitive if it is not. It is not
# derived from the Host header, because the Host header is attacker-controlled.
CLOUD_PUBLIC_URL=http://localhost:9500

# Mail. With no CLOUD_SMTP_ADDR, Cloud writes verification and reset links to
# its log instead of sending them, warns at startup, and warns again on every
# message. That is the intended development flow; the warnings are what stop it
# becoming the accidental production one, where accounts are created, the
# response says a message is on its way, and the link is in a log nobody reads.
CLOUD_SMTP_ADDR=
CLOUD_SMTP_FROM=
CLOUD_SMTP_USER=
CLOUD_SMTP_PASSWORD=

# Refuse passwords that appear in a known breach, via Have I Been Pwned's
# k-anonymity range API — the password never leaves this process, only the first
# five characters of its SHA-1. Set to false to skip it entirely. When it is on
# and the service cannot be reached, the password is accepted and a warning is
# logged: sign-up must not stop working because a third party is down.
CLOUD_HIBP_CHECK=true

# Read X-Forwarded-For when rate limiting. Leave off unless something you
# control terminates in front — the header is trivially spoofable, and a limiter
# keyed on a spoofable value is one an attacker resets on every request.
CLOUD_TRUST_PROXY=false
