# atlantis-signer — narrow cert-signing service.
# Holds the intermediate CA key; accepts CSRs and issues caller leaf certs.
# No CA key leaves this container.

# ── build ──────────────────────────────────────────────────────────────────────
FROM golang:1.26.4-alpine AS builder

WORKDIR /build
COPY go.mod go.sum ./
# clients/go is a replace-directive sub-module; copy it so go mod download works.
COPY clients/ clients/
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/atlantis-signer ./cmd/signer

# ── runtime ────────────────────────────────────────────────────────────────────
FROM alpine:3.20

RUN addgroup -S signer && adduser -S signer -G signer
USER signer

COPY --from=builder /out/atlantis-signer /usr/local/bin/atlantis-signer

# Container-internal ports. A deployment maps these to loopback-only host
# ports; the CA key is behind them, so they must never be reachable from a
# public interface.
#
# 7070 is mTLS and carries /issue. 7071 is plaintext and carries /healthz only.
# The split exists for the line below: the health check runs inside the
# container with nothing but the CA directory mounted, so it holds no client
# certificate and cannot complete a handshake with 7070. Left on one port, the
# container would be permanently unhealthy and anything waiting on
# `condition: service_healthy` would never start.
EXPOSE 7070 7071

ENV CA_DIR=/ca-private \
    SIGNER_LISTEN=:7070 \
    SIGNER_HEALTH_LISTEN=:7071

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s \
  CMD wget -q -O - http://127.0.0.1:7071/healthz || exit 1

ENTRYPOINT ["atlantis-signer"]
