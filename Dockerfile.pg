# Dockerfile.pg — the Postgres image provisioned organisations run.
#
# CloudNativePG's standard image with TimescaleDB added.
#
# internal/storage/pg/pool.go registers pgvector types on every connection, so
# the server fails at pool-open on a database without the vector extension.
#
# internal/codegen emits create_hypertable for a schema that declares a
# hypertable, so the database needs TimescaleDB.
#
# timescaledb-2-oss-postgresql-17 is the Apache-2 build. The provisioner sets
# ATL_REQUIRE_APACHE_TIMESCALE on each organisation's server, which then refuses
# to start against the TSL build.

# The image tag is derived from these two lines by deploy/pg-image-tag.sh.
#
# A TimescaleDB package ships only its own versioned library, and a database
# loads the library of the extension version it was created with. An image
# with a different TimescaleDB under the same tag breaks those databases on
# any node that pulls it:
#   could not access file "$libdir/timescaledb-2.30.2"
ARG PG_VERSION=17.11
ARG TIMESCALE_VERSION=2.30.2~debian13-1711

# The packagecloud signing key, fetched in its own stage so curl and gnupg stay
# out of the published image.
FROM debian:trixie-slim AS key
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    curl -fsSL https://packagecloud.io/timescale/timescaledb/gpgkey \
        | gpg --dearmor -o /timescaledb.gpg

# The standard variant carries pgvector.
FROM ghcr.io/cloudnative-pg/postgresql:${PG_VERSION}-standard-trixie
ARG PG_VERSION
ARG TIMESCALE_VERSION

USER root

COPY --from=key /timescaledb.gpg /etc/apt/trusted.gpg.d/timescaledb.gpg

# The loader is pinned too: the extension's dependency on it is >=.
#
# The apt lists and the packagecloud source are removed in the same layer, so
# neither reaches the published image.
RUN set -eux; \
    . /etc/os-release; \
    echo "deb https://packagecloud.io/timescale/timescaledb/debian/ ${VERSION_CODENAME} main" \
        > /etc/apt/sources.list.d/timescaledb.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        "timescaledb-2-oss-postgresql-17=${TIMESCALE_VERSION}" \
        "timescaledb-2-loader-postgresql-17=${TIMESCALE_VERSION}"; \
    rm -rf /var/lib/apt/lists/* /etc/apt/sources.list.d/timescaledb.list

# The tag claims these versions. The provisioner's bootstrap SQL creates vector,
# citext and timescaledb in every organisation's database.
RUN set -eux; \
    test "$(/usr/lib/postgresql/17/bin/postgres --version | awk '{print $3}')" = "$PG_VERSION"; \
    test -f "/usr/lib/postgresql/17/lib/timescaledb-${TIMESCALE_VERSION%%~*}.so"; \
    for ext in vector citext timescaledb; do \
        test -f "/usr/share/postgresql/17/extension/$ext.control"; \
    done

# CNPG's default postgresUID.
USER 26
