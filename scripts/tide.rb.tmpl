# Homebrew formula for tide, templated at release time.
#
# The binaries live on the releases host (a GCS bucket), not on GitHub. A tap
# is the one distribution piece that must be a public git repository — brew
# clones it — so this template exists for whenever that tap is wanted; until
# then the install script is the whole story. Fill __VERSION__ and the four
# __SHA_*__ values from checksums.txt.
class Tide < Formula
  desc "Atlantis CLI: plan, apply and generate against your schema"
  homepage "https://tryatlantis.dev"
  version "__VERSION__"
  license :cannot_represent

  on_macos do
    if Hardware::CPU.arm?
      url "https://releases.tryatlantis.dev/__VERSION__/tide-__VERSION__-darwin-arm64.tar.gz"
      sha256 "__SHA_DARWIN_ARM64__"
    else
      url "https://releases.tryatlantis.dev/__VERSION__/tide-__VERSION__-darwin-amd64.tar.gz"
      sha256 "__SHA_DARWIN_AMD64__"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://releases.tryatlantis.dev/__VERSION__/tide-__VERSION__-linux-arm64.tar.gz"
      sha256 "__SHA_LINUX_ARM64__"
    else
      url "https://releases.tryatlantis.dev/__VERSION__/tide-__VERSION__-linux-amd64.tar.gz"
      sha256 "__SHA_LINUX_AMD64__"
    end
  end

  def install
    bin.install "tide"
  end

  test do
    system "#{bin}/tide", "version"
  end
end
