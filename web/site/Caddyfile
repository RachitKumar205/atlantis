# Static file server for tryatlantis.dev on Cloud Run.
#
# Cloud Run terminates TLS, so automatic HTTPS is off.
#
# An unqualified address binds 0.0.0.0, which Cloud Run requires.
{
	auto_https off
	admin off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Content-hashed filenames, so a URL's bytes never change.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@rest not path /_astro/*
	header @rest Cache-Control "public, max-age=0, must-revalidate"

	# The home page in markdown for a client that asks for it. Both forms of
	# `/` carry Vary: Accept, so a cache keeps them apart.
	#
	# header matches the request before rewrite changes its path, so the
	# negotiated `/` sets its own Content-Type.
	header / Vary Accept
	@markdown {
		path /
		header Accept *text/markdown*
	}
	header @markdown Content-Type "text/markdown; charset=utf-8"
	rewrite @markdown /index.md

	@md path /index.md
	header @md Content-Type "text/markdown; charset=utf-8"

	file_server

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
	}
}
