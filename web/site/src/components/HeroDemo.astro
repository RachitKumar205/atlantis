// Sidebar.tsx's NAV, in its order.
const nav = [
  { icon: icons.stack, current: false },
  { icon: icons.history, current: false },
  { icon: icons.cube, current: false },
  { icon: icons.cpu, current: false },
  { icon: icons.pulse, current: false },
  { icon: icons.users, current: false },
  { icon: icons.shield, current: true },
  { icon: icons.archive, current: false },
  { icon: icons.gearSix, current: false },
];
---

<figure class="window console" aria-label={`${hero.approval.title}. ${hero.approval.text.replaceAll("`", "")}`}>
  <div class="window__bar console__bar">
    <span class="console__address mono">console.tryatlantis.dev/approvals</span>
  </div>
  <div class="console__body" aria-hidden="true">
    <div class="console__rail">
      <span class="console__logo"><Mark size={26} /></span>
      <span class="console__org"><span>a</span></span>
      <span class="console__nav">
        {
          nav.map((n) => (
            <span class:list={["console__navitem", { "is-current": n.current }]}>
              <svg viewBox="0 0 256 256"><path d={n.icon} /></svg>
            </span>
          ))
        }
      </span>
      <span class="console__spacer"></span>
      <span class="console__avatar">MS</span>
      <span class="console__nav">
        <span class="console__navitem"><svg viewBox="0 0 256 256"><path d={icons.gear} /></svg></span>
        <span class="console__navitem"><svg viewBox="0 0 256 256"><path d={icons.external} /></svg></span>
        <span class="console__navitem console__navitem--danger"><svg viewBox="0 0 256 256"><path d={icons.signOut} /></svg></span>
      </span>
    </div>

    <div class="console__main">
      <div class="console__head">
        <div>
          <p class="console__title">Approvals</p>
          <p class="console__sub">schema changes waiting on a decision</p>
        </div>
        <span class="console__btn console__btn--ghost console__search">
          <svg viewBox="0 0 256 256"><path d={icons.search} /></svg>
          Search
          <kbd class="console__kbd">⌘K</kbd>
        </span>
      </div>

      <div class="console__page">
        <div class="console__card">
          <div class="console__row">
            <div class="console__who">
              <div class="console__meta">
                <span class="console__badge console__badge--destroy">destructive</span>
                <strong>checkout-api</strong>
                <span class="console__badge console__badge--add">rehearsed · pass</span>
                <span>requested by <span class="mono">ci-agent</span></span>
              </div>
              <p class="console__needs">Needs <strong>admin</strong><span class="console__nowrap"> · expires 2026-11-22T17:04:31Z</span></p>
            </div>
            <div class="console__actions">
              <span class="console__btn console__btn--ghost">Rehearse</span>
              <span class="console__btn">Hide</span>
            </div>
          </div>

          <div class="console__review">
            <p class="console__label">Proposed schema</p>
            <div class="console__plan">
              <p class="console__planhead mono">schema/shop.atl</p>
              <Code class="console__code console__code--numbered" code={parkSchema} lang={atl} theme={datumCodeTheme} />
            </div>

            <p class="console__label console__label--sql">SQL this will run</p>
            <div class="console__plan console__plan--sql">
              <Code class="console__code" code={parkSql} lang="sql" theme={datumCodeTheme} />
            </div>

            <div class="console__field">
              <span class="console__fieldlabel">Reason</span>
              <span class="console__input">Checked with the checkout team: nothing reads legacy_notes</span>
            </div>

            <div class="console__decide">
              <span class="console__btn"><svg viewBox="0 0 256 256"><path d={icons.check} /></svg>Approve</span>
              <span class="console__btn console__btn--danger"><svg viewBox="0 0 256 256"><path d={icons.x} /></svg>Reject</span>
              <span class="console__btn console__btn--ghost">Override</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</figure>
