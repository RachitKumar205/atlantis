# Dockerfile.console — multi-stage build for the atlantis management console.
#
# Stage 0: generate Go pb stubs (buf generate)
# Stage 1: build the React/TypeScript SPA (web/console → dist/)
# Stage 2: build the Go BFF binary (cmd/console), embedding dist/
# Stage 3: minimal runtime image
#
# Usage:
#   docker build -f Dockerfile.console -t atlantis-console:local .

# ── Stage 0: proto generation ─────────────────────────────────────────────────
# clients/go/pb is gitignored — caller SDKs regenerate against the version of
# atlantis they target — so a fresh clone has none of the *.pb.go files that
# internal/runtime/pagination.go (reachable from internal/console/sandbox.go)
# imports. Running buf generate inside the build lets a clean clone produce a
# working image with no host-side codegen step.
#
# The base used to be `bufbuild/buf:1.41.0`, which ships neither of the LOCAL
# plugins buf.gen.yaml declares, so this stage always failed with
# `plugin protoc-gen-go: executable file not found in $PATH`. See the same note
# in Dockerfile. Plugin versions match `make proto`; change them together.
FROM --platform=$BUILDPLATFORM golang:1.25.12-alpine AS proto
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go install github.com/bufbuild/buf/cmd/buf@v1.41.0 && \
    go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.6 && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.5.1
WORKDIR /src
COPY buf.yaml buf.gen.yaml ./
COPY atlantis ./atlantis
RUN buf generate

# ── Stage 1: SPA build ────────────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM node:22-alpine AS spa-build

# An npm workspace, so the install runs at the root and there is exactly one
# lockfile. Both member manifests are copied before the sources, so a change
# to a component does not invalidate the install layer.
#
# `npm ci` needs every workspace's package.json present: it installs the whole
# tree from the root lockfile and fails if a member named there is missing.
# Copying only web/console/ is what the pre-workspace version did, and it is
# why @atlantis/shared would not resolve here.
WORKDIR /app
COPY package.json package-lock.json ./
COPY web/console/package.json ./web/console/
COPY web/shared/package.json ./web/shared/
RUN npm ci --prefer-offline

COPY web/shared/ ./web/shared/
COPY web/console/ ./web/console/
RUN npm run build --workspace web/console

# ── Stage 2: Go build ─────────────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM golang:1.25.12-alpine AS go-build

# CGO toolchain. The console binary embeds the sandbox runtime, which
# depends on pg_query_go (vendored libpg_query, statically linked).
# build-base provides gcc + musl headers for the cgo compile.
RUN apk add --no-cache build-base

WORKDIR /src

# go.mod has a replace directive for ./clients/go; the sub-module's go.mod is
# needed to resolve dependencies before the full source is copied.
COPY go.mod go.sum ./
COPY clients/go/go.mod clients/go/go.sum* ./clients/go/
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
# Vite outDir is ../../cmd/console/dist (relative to web/console/),
# which resolves to /app/cmd/console/dist inside the spa-build stage.
COPY --from=spa-build /app/cmd/console/dist ./cmd/console/dist/
# Pull in the freshly-generated pb stubs from the proto stage. Has to land
# AFTER `COPY . .` so a stale local clients/go/pb/ in the build context
# doesn't shadow the fresh generate.
COPY --from=proto /src/clients/go/pb ./clients/go/pb

# Static-linked binary so the runtime image can stay on a minimal base.
# The pg_query_go vendored libpg_query archive is statically pulled in;
# the result is a single self-contained executable.
#
# -tags embedspa bakes the SPA in. It is NOT the default — an untagged build has
# no //go:embed directive at all, which is what lets a clean checkout and every
# CI step compile with no Node. This is a shipped binary, so it opts in. A
# binary built without it answers 404 on the SPA routes naming the make target,
# rather than serving a blank page. See cmd/cloud/spa_none.go.
#
# The tag goes in the build line, not in GOFLAGS: GOFLAGS already carries the
# static-link ldflags and appending to it here would be one string doing two
# unrelated jobs.
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=1 \
    GOFLAGS="-ldflags=-extldflags=-static" \
    go build -tags embedspa -o /out/atlantis-console ./cmd/console

# ── Stage 3: runtime ──────────────────────────────────────────────────────────
FROM alpine:3.20

RUN addgroup -S app && adduser -S -G app app
USER app

COPY --from=go-build /out/atlantis-console /usr/local/bin/atlantis-console

EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD wget -q -O - http://127.0.0.1:3000/api/setup/status >/dev/null 2>&1 || exit 1

ENTRYPOINT ["/usr/local/bin/atlantis-console"]
