// Fixture schema for TestEmittersMatchGolden.
//
// Not a realistic application schema — a deliberately small one chosen so the
// golden output stays reviewable while still crossing the emitter paths where a
// silent change would matter:
//
//   - nullable AND not-null columns of each Go shape, because nullability
//     selects between two different emissions in the cursor extractor, the
//     bind arms and the scan targets
//   - a nullable ordering column, which is what the keyset predicate branches on
//   - `partition by`, which adds the tenant argument, the RLS policy and the
//     boundary WITH CHECK
//   - a foreign key into the other entity, which drives the include slots
//   - `ttl_field`, which the sweeper reads
//   - `interval`, deliberately: it is the type whose emitted code did not
//     compile, so a fixture without it would leave the compile check blind to
//     the one case it was built for
//   - a `job`, because both jobs emitters return nil for an IR declaring none,
//     and an emitter producing nothing is indistinguishable here from one
//     producing the right thing
//
// Adding a field here changes the golden files. That is the point: the diff is
// the review. Regenerate with `go test ./internal/codegen -run Golden -update`.

entity Author in library {
  id         bigint primary
  name       text not null
  bio        text
  rating     double
  tenure     interval
  created_at timestamptz not null default now()
}

entity Book in library {
  id         bigint primary
  tenant     varchar(32) not null
  title      text not null
  author_id  bigint not null references library.Author.id
  score      real
  page_count int
  summary    text
  expires_at timestamptz
  created_at timestamptz not null default now()

  partition by tenant
  ttl_field expires_at
}

// A custom query and a custom procedure, because EmitCustomServer emits Go of
// the same kind as the entity server — it imports pb and runtime and had the
// same unresolvable pb prefix — and nothing had ever compiled its output.
//
// Declared against Author rather than Book on purpose: Book is partitioned, and
// a partitioned custom query takes the tenant-binding path, which is worth
// covering separately from the plain one rather than only in combination.

query BooksByAuthor for Book {
  input { author_id: bigint }
  output as Book
  sql touches(Book) {
    SELECT id, tenant, title, author_id, score, page_count, summary, expires_at, created_at
    FROM library_book WHERE author_id = $author_id
  }
}

procedure RetireAuthor for Author {
  input { author_id: bigint }
  steps {
    update Author set bio = "retired" where id = $author_id
  }
}

// The three args cross the paths the jobs emitters branch on: a not-null
// scalar, a nullable one (a pointer in the Args struct), and a timestamptz,
// which is what adds the `time` import the emitter otherwise prunes.
job ReindexAuthor in library {
  args {
    author_id  bigint not null
    reason     text
    not_before timestamptz not null
    backoff    interval not null
    weights    vector(3)
    payload    bytea
  }
  retries 3
  timeout 30s
  queue "maintenance"
}
